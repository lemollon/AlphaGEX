!.claude/agents/

# OS
.DS_Store
Thumbs.db

# Data
*.csv
*.xlsx
*.db
*.sqlite

# ...except the committed baseline seeds. These are SHIPPED DATA, not scratch
# output: the flow/gamma/VIX z-scores compute against them and _z() returns
# None with fewer than 40 rows, so a missing file does not error — it silently
# turns the signal off. risk_flow_baseline_pm.csv was caught by the blanket
# rule above and never committed at all, which left the 12:00 and 13:30
# re-check clocks blind in production from the day they shipped and kept CI
# red on main. The other four were force-added one at a time; this negation is
# so the next one does not have to be.
!spreadworks/backend/data/*.csv
*.zip

# ORAT Historical Data (large files - process locally)
data/orat_raw/
data/orat_processed/
data/prices/

# Strategy Stats (auto-generated, don't commit)
.strategy_stats/

# Backtest results (auto-generated)
backtest/results/

# Large backtest source data — NOT checked in (see backtest/data/README.md)
backtest/data/*.parquet

# Logs (runtime artifacts - only root logs directory)
/logs/
*.log
# Don't ignore frontend app/logs page
!frontend/src/app/logs/
quant/.models/
models/*.pkl
.coverage

# Runtime state files
data/circuit_breaker_state.json

# GOLIATH calibration parquet cache (per-day invalidation; runtime artifact)
.goliath_cache/

# Superpowers brainstorming session artifacts (HTML mockups, server state)
.superpowers/

# touch-pin per-trade CSV outputs (regenerable)
backtest/touch_pin/output/*.csv
backtest/touch_pin/output/*.log
!backtest/touch_pin/output/.gitkeep

# skew_signal per-trade CSV outputs (regenerable)
backtest/skew_signal/output/*.csv
backtest/skew_signal/output/*.log
!backtest/skew_signal/output/.gitkeep
spreadworks/frontend/dist/
