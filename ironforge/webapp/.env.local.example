# PostgreSQL (Render internal URL)
DATABASE_URL=postgresql://user:password@host:5432/ironforge

# Tradier API (primary key used for market data quotes)
TRADIER_API_KEY=your_tradier_sandbox_key
TRADIER_BASE_URL=https://sandbox.tradier.com/v1

# Three sandbox accounts for FLAME trade mirroring
# Each account gets the same trades mirrored simultaneously
# API keys are required; account IDs are auto-discovered from Tradier if omitted
TRADIER_SANDBOX_KEY_USER=your_sandbox_key
TRADIER_SANDBOX_KEY_MATT=matts_sandbox_key
TRADIER_SANDBOX_KEY_LOGAN=logans_sandbox_key
TRADIER_SANDBOX_ACCOUNT_ID_USER=your_account_id
TRADIER_SANDBOX_ACCOUNT_ID_MATT=matts_account_id
TRADIER_SANDBOX_ACCOUNT_ID_LOGAN=logans_account_id

# --- Vibe Consulting: GHL Spanish-answer translation webhook ---
# Used by src/app/api/webhooks/ghl-translate/route.ts
VIBE_WEBHOOK_SECRET=
GHL_PIT_TOKEN=
GHL_LOCATION_ID=
ANTHROPIC_API_KEY=

# --- Apple In-App Purchase (iOS, Guideline 3.1.1) ---
# Used by src/lib/billing/apple/verifier.ts and /api/billing/apple/verify + /notifications.
# 'Sandbox' | 'Production'. Optional — without it, the environment follows this deployment's
# existing prod/sandbox switch (IRONFORGE_ENV=sandbox -> Sandbox, else Production; see
# lib/sandbox.ts). Set explicitly only to override that.
APPLE_IAP_ENVIRONMENT=
# Defaults to trade.ironforge.app — set only if the bundle ID ever changes.
APPLE_IAP_BUNDLE_ID=
# Optional override for the committed Apple Root CA G3 cert
# (src/lib/billing/apple/AppleRootCA-G3.cer). Point this at an absolute path only if that
# binary file doesn't survive the deploy's file trace.
APPLE_ROOT_CA_PATH=
