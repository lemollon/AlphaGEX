{
  "cli": {
    "version": ">= 21.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://ironforge-sandbox.onrender.com",
        "EXPO_PUBLIC_SENTRY_DSN": ""
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://ironforge-sandbox.onrender.com",
        "EXPO_PUBLIC_SENTRY_DSN": ""
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://ironforge.trade",
        "EXPO_PUBLIC_SENTRY_DSN": ""
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "production-local": {
      "extends": "production",
      "credentialsSource": "local"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "lemollon@icloud.com",
        "ascAppId": "6804037937",
        "appleTeamId": "NDQD9S95ZK"
      },
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "internal"
      }
    }
  }
}
