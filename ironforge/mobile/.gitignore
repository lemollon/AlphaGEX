node_modules/
.expo/
dist/
dist-web/
*.log

# Google Play service account key. eas.json's submit.production.android
# serviceAccountKeyPath points at this filename, so the moment anyone creates the key
# it lands in a tracked path. It grants RELEASE-TO-PRODUCTION on the Play account, and
# this repo is worked in by several sessions at once, one of which has already swept
# unrelated files into a PR. Never let it become committable.
google-play-service-account.json

# Android signing material, if it is ever pulled down locally. EAS holds the keystore
# remotely today; a leaked upload key cannot be rotated for an app already on Play.
*.jks
*.keystore
*.p12

# eas-cli local credentials. Holds the .p12 passphrase in plain text and points at the
# distribution private key. `*.p12` below is already ignored, but this file is the one
# that makes the key USABLE, and it is created at the repo root where a `git add -A` in
# a shared worktree would happily take it.
credentials.json
*.mobileprovision
